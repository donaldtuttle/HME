{
  "name": "hme-decision-revision-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "predev": "python3 scripts/package_source.py",
    "dev": "vite",
    "build": "python3 scripts/package_source.py && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:fixture": "node --experimental-strip-types ../../experiments/decision_revision_v1/rev.test.ts && node --experimental-strip-types ../../experiments/decision_revision_v1/regression.test.ts",
    "test:ui": "node scripts/build-test-app.mjs && node tests/ui.test.mjs",
    "test": "npm run test:fixture && npm run test:ui",
    "test:build": "node tests/build.test.mjs && python3 scripts/check_source_archive.py"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "lucide-react": "0.510.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@vitejs/plugin-react": "5.0.4",
    "vite": "6.4.2",
    "typescript": "5.9.3",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@types/node": "22.16.5",
    "@testing-library/react": "16.3.3",
    "esbuild": "0.25.12",
    "jsdom": "30.1.1"
  }
}
